# Postgres (compose creates the db with these)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=code_tracker

# Prisma CLI on the host (container overrides with the compose-internal host)
DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5434/code_tracker

# Auth.js — MUST equal the portfolio's AUTH_SECRET of the same stage (prod/dev)
AUTH_SECRET=
AUTH_URL=https://code.roger.tw
AUTH_TRUST_HOST=true
# Same cookie the portfolio issues on .roger.tw (prod: __Secure-rtw.session, dev: __Secure-rtw.session-dev)
AUTH_COOKIE_NAME=__Secure-rtw.session
AUTH_COOKIE_DOMAIN=.roger.tw

# Where to send users to sign in (prod: https://roger.tw, dev: https://dev.roger.tw)
PORTFOLIO_URL=https://roger.tw
